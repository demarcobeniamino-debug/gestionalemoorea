{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cassa",
  "version": "0.1.0",
  "identifier": "it.gestionale.cassa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cassa",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
